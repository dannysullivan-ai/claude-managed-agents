# The slides and app interfaces open without credentials.
# /agent is the completed demo; /lab runs your exercise functions.
# Both use real Claude Managed Agents when you send a brief.
ANTHROPIC_API_KEY=

# npm run setup:agent saves these reusable resource settings.
OFFSITE_AGENT_ID=
OFFSITE_AGENT_VERSION=
OFFSITE_ENVIRONMENT_ID=
OFFSITE_VENUES_FILE_ID=
OFFSITE_VALIDATOR_FILE_ID=
SESSION_SECRET=

# Optional setup-only model choice; setup verifies account model metadata.
CLAUDE_MODEL=claude-sonnet-5-5

# npm run dev serves completed /agent and unfinished /lab together.
# Optional continuity defect affects only /lab. Leave unset for normal use.
# WORKSHOP_FAULT=continuity

# No NEXT_PUBLIC_ credentials. Protect a deployed /agent before sharing it:
# each new session uses paid execution capped at $2 in list cost, plus in-flight work.
